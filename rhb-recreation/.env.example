# PostgreSQL connection (Neon, Vercel Postgres, or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/rhb_premier?sslmode=require

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=rhb-premier-session-k9m2x7p4q8w1n6v3b5h0j2l9f7d4s6a8c1e3g5i7

# Site-wide access PIN (server-side only, never expose to frontend)
SITE_ACCESS_PIN=1810

# Balance view re-authentication PIN (server-side only)
BALANCE_VIEW_PIN=1810

# Allowed browser origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://rhb-recreation-ten.vercel.app

# Initial seed credentials (used once during DB migration when no users exist)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_USER_USERNAME=govind
SEED_USER_PASSWORD=govind123

# Protect one-time migration endpoint
MIGRATION_SECRET=rhb-premier-migration-a3f8c2e1b9d7h4j6k8m0n2p4q6s8u0w2

# Optional: Upstash Redis for distributed rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
